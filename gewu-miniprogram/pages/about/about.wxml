<view class="about">
  <view class="logo">⚛️</view>
  <view class="name">{{L.appName}}</view>
  <view class="ver">{{L.versionLine}}</view>

  <view class="stat-card">{{cats}}</view>

  <view class="setting-card">
    <view class="setting-text">
      <view class="setting-title">{{L.haptic}}</view>
      <view class="setting-sub">{{L.hapticSub}}</view>
    </view>
    <switch checked="{{haptic}}" bindchange="toggleHaptic" color="#1565C0" />
  </view>

  <view class="setting-card">
    <view class="setting-text">
      <view class="setting-title">{{L.language}}</view>
      <view class="setting-sub">{{L.languageSub}}</view>
    </view>
    <view class="lang-toggle">
      <view class="lang-btn {{lang === 'zh' ? 'active' : ''}}" data-lang="zh" bindtap="switchLanguage">{{L.zh}}</view>
      <view class="lang-btn {{lang === 'en' ? 'active' : ''}}" data-lang="en" bindtap="switchLanguage">{{L.en}}</view>
    </view>
  </view>

  <view class="desc">{{L.desc1}}</view>
  <view class="desc">{{L.desc2}}</view>
</view>
