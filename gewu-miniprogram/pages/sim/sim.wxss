.wrap { display: flex; flex-direction: column; height: 100vh; background: #EEF1F5; }

/* 画布区域：flex 伸展，承载浮动暂停按钮 */
.stage { position: relative; flex: 1 1 auto; min-height: 30vh; }
.cv { width: 100%; height: 100%; background: #fff; }

/* 控制面板：圆角上浮卡片 */
.panel {
  flex: 0 1 auto; max-height: 50vh; background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.1);
  padding: 28rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
/* 顶部小把手，暗示可滚动 */
.panel::before {
  content: ''; display: block; width: 72rpx; height: 8rpx; border-radius: 4rpx;
  background: #E0E4E8; margin: 0 auto 20rpx;
}

.stepper-row {
  display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #F0F2F4;
}
.stepper-label { flex: 1; font-size: 29rpx; color: #37474F; font-weight: 600; }
.stepper-btn {
  width: 60rpx; height: 60rpx; line-height: 56rpx; text-align: center; font-size: 34rpx;
  border: 2rpx solid; border-radius: 50%; font-weight: bold;
}
.stepper-val { width: 76rpx; text-align: center; font-size: 32rpx; font-weight: bold; }
.stepper-hov { background: rgba(0, 0, 0, 0.06); transform: scale(0.9); }

.actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 8rpx 0 16rpx; }
.btn {
  flex: 1 1 30%; min-width: 150rpx; font-size: 28rpx; line-height: 2.5; margin: 0;
  background: #F2F5F9; color: #1565C0; border-radius: 40rpx; font-weight: 500;
}
.btn.primary {
  background: linear-gradient(135deg, #1E88E5, #1565C0); color: #fff; font-weight: bold;
  box-shadow: 0 4rpx 14rpx rgba(21, 101, 192, 0.3);
}
.btn::after { border: none; }
.btn-hov { opacity: 0.82; transform: scale(0.97); }

.ctrl { margin-top: 14rpx; }
.ctrl-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rpx; }
.ctrl-label { font-size: 27rpx; color: #546E7A; }
.ctrl-val {
  font-size: 25rpx; color: #1565C0; font-weight: 600;
  background: #E8F1FB; padding: 2rpx 16rpx; border-radius: 20rpx;
}
slider { margin: 2rpx 0; }
