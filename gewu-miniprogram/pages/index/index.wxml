<view class="page">
  <view class="header">
    <view class="header-text">
      <view class="h-title">格物实验</view>
      <view class="h-sub">Gewu Lab · {{total}} 个互动物理仿真</view>
    </view>
    <view class="hbtn" bindtap="randomSim" hover-class="hov">🎲</view>
    <view class="hbtn" bindtap="openAbout" hover-class="hov">⚙</view>
  </view>

  <view class="search">
    <text class="search-icon">🔍</text>
    <input class="search-input" value="{{keyword}}" bindinput="onSearch"
           placeholder="搜索：单摆 / 电路 / 光学 / 能量…" placeholder-class="search-ph" confirm-type="search" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <!-- 分类快捷跳转 -->
  <scroll-view scroll-x class="catbar" enable-flex>
    <view class="catchip" wx:for="{{catChips}}" wx:key="name"
          data-id="cat{{index}}" bindtap="jumpCat" hover-class="chip-hov">
      {{item.name}} <text class="catnum">{{item.count}}</text>
    </view>
  </scroll-view>

  <scroll-view scroll-y class="body" scroll-into-view="{{jumpId}}" scroll-with-animation>
    <!-- 探索进度 -->
    <view class="progress-card">
      <view class="progress-row">
        <text class="progress-label">{{progress >= 100 ? '🏆 全部探索完成！' : '🧭 探索进度'}}</text>
        <text class="progress-num">{{visitedCount}} / {{total}}</text>
      </view>
      <view class="progress-bar"><view class="progress-fill {{progress >= 100 ? 'gold' : ''}}" style="width:{{progress}}%;"></view></view>
    </view>

    <!-- 收藏 -->
    <block wx:if="{{favs.length && !keyword}}">
      <view class="cat">⭐ 我的收藏</view>
      <scroll-view scroll-x class="chips" enable-flex>
        <view class="chip" wx:for="{{favs}}" wx:key="id" data-id="{{item.id}}" bindtap="openSim" hover-class="chip-hov"
              style="background:{{item.bg}};">
          <text class="chip-emoji">{{item.emoji}}</text><text class="chip-text">{{item.title}}</text>
        </view>
      </scroll-view>
    </block>

    <!-- 最近使用 -->
    <block wx:if="{{recent.length && !keyword}}">
      <view class="cat">🕐 最近使用</view>
      <scroll-view scroll-x class="chips" enable-flex>
        <view class="chip" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openSim" hover-class="chip-hov">
          <text class="chip-emoji">{{item.emoji}}</text><text class="chip-text">{{item.title}}</text>
        </view>
      </scroll-view>
    </block>

    <!-- 分类列表 -->
    <block wx:for="{{groups}}" wx:key="name">
      <view class="cat" id="{{item.aid}}">{{item.name}} · {{item.items.length}}</view>
      <view class="card" wx:for="{{item.items}}" wx:for-item="sim" wx:key="id"
            data-id="{{sim.id}}" bindtap="openSim" bindlongpress="toggleFav" hover-class="card-hov">
        <view class="icon" style="background: {{sim.bg}};">
          <text class="emoji">{{sim.emoji}}</text>
        </view>
        <view class="card-text">
          <view class="card-title">{{sim.title}}<text wx:if="{{sim.fav}}" class="fav-badge">⭐</text></view>
          <view class="card-sub">{{sim.sub}}</view>
        </view>
        <view class="arrow">›</view>
      </view>
    </block>

    <view wx:if="{{empty}}" class="empty">
      <view class="empty-emoji">🔬</view>
      <view class="empty-text">没有找到「{{keyword}}」相关的仿真</view>
      <view class="empty-hint" bindtap="clearSearch">清除搜索</view>
    </view>
    <view wx:else class="tip">长按卡片可收藏 · 共 {{total}} 个仿真</view>
  </scroll-view>
</view>
