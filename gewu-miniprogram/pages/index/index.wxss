.page { display: flex; flex-direction: column; height: 100vh; background: #EEF1F5; }
.header {
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 60%, #0D47A1 100%);
  padding: 48rpx 36rpx 56rpx; display: flex; align-items: center;
  border-radius: 0 0 36rpx 36rpx;
}
.header-text { flex: 1; }
.h-title { color: #fff; font-size: 46rpx; font-weight: bold; letter-spacing: 2rpx; }
.h-sub { color: rgba(255,255,255,0.85); font-size: 24rpx; margin-top: 8rpx; }
.hbtn { color: #fff; font-size: 40rpx; padding: 8rpx 10rpx; margin-left: 6rpx; }
.hov { opacity: 0.5; }

.progress-card {
  background: #fff; border-radius: 20rpx; padding: 22rpx 26rpx; margin-bottom: 8rpx;
  box-shadow: 0 3rpx 14rpx rgba(0,0,0,0.05);
}
.progress-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.progress-label { font-size: 26rpx; color: #455A64; font-weight: bold; }
.progress-num { font-size: 26rpx; color: #1565C0; font-weight: bold; }
.progress-bar { height: 14rpx; background: #ECEFF1; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg,#42A5F5,#1565C0); border-radius: 8rpx; transition: width 0.4s; }

.chips { white-space: nowrap; margin-bottom: 8rpx; }
.chip {
  display: inline-flex; align-items: center; background: #fff; border-radius: 40rpx;
  padding: 12rpx 24rpx; margin-right: 16rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.chip-hov { opacity: 0.6; transform: scale(0.96); }
.chip-emoji { font-size: 32rpx; margin-right: 10rpx; }
.chip-text { font-size: 26rpx; color: #37474F; }

.fav-badge { font-size: 22rpx; margin-left: 10rpx; }

.search {
  display: flex; align-items: center; margin: -20rpx 28rpx 0; padding: 0 24rpx;
  height: 76rpx; background: #fff; border-radius: 38rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  position: relative; z-index: 2;
}
.search-icon { font-size: 28rpx; margin-right: 14rpx; opacity: 0.6; }
.search-input { flex: 1; font-size: 28rpx; color: #263238; }
.search-ph { color: #B0BEC5; }
.search-clear {
  font-size: 30rpx; color: #90A4AE; padding: 8rpx 12rpx; margin-right: -8rpx;
}

.catbar { white-space: nowrap; padding: 18rpx 28rpx 4rpx; flex-shrink: 0; }
.catchip {
  display: inline-flex; align-items: center; background: #fff; border-radius: 32rpx;
  padding: 10rpx 22rpx; margin-right: 14rpx; font-size: 25rpx; color: #37474F; font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.catnum { font-size: 21rpx; color: #1565C0; margin-left: 6rpx; font-weight: bold; }

.progress-fill.gold { background: linear-gradient(90deg, #FFB300, #FF8F00); }

.body { flex: 1; padding: 12rpx 28rpx 24rpx; box-sizing: border-box; }
.cat {
  font-size: 27rpx; color: #37474F; font-weight: bold; margin: 24rpx 4rpx 14rpx;
  padding-left: 18rpx; border-left: 8rpx solid #1565C0; line-height: 1;
}

.card {
  display: flex; align-items: center; background: #fff; border-radius: 26rpx;
  padding: 24rpx; margin-bottom: 18rpx; box-shadow: 0 4rpx 18rpx rgba(60,80,120,0.07);
}
.card-hov { transform: scale(0.98); opacity: 0.92; background: #F5F7FA; }
.icon { width: 92rpx; height: 92rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; }
.emoji { font-size: 46rpx; }
.card-text { flex: 1; margin-left: 24rpx; }
.card-title { font-size: 32rpx; font-weight: bold; color: #22303C; }
.card-sub { font-size: 24rpx; color: #78909C; margin-top: 6rpx; }
.arrow { font-size: 40rpx; color: #CFD8DC; }
.tip { text-align: center; color: #90A4AE; font-size: 24rpx; padding: 20rpx 0 60rpx; }

.empty { text-align: center; padding: 100rpx 0; }
.empty-emoji { font-size: 96rpx; }
.empty-text { font-size: 28rpx; color: #607D8B; margin-top: 20rpx; }
.empty-hint { display: inline-block; margin-top: 24rpx; font-size: 26rpx; color: #1565C0; padding: 12rpx 32rpx; border: 1rpx solid #1565C0; border-radius: 40rpx; }
